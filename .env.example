# Smart Accident Detection & Emergency Response System Environment Variables

# Application Settings
FLASK_ENV=development
PORT=5000
DEBUG=True
SECRET_KEY=smart-accident-emergency-uk-dev-secret-key-2026

# Database Configuration (Tier 3)
# Leave blank to automatically use local SQLite database during development
AZURE_SQL_CONNECTION_STRING=

# Azure Blob Storage Configuration (Crash Evidence & Dashcam Media)
# Leave blank to automatically save evidence to local directory during development
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=crash-evidence

# Azure Application Insights & Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Azure OpenAI Configuration (AI Agents Layer)
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01
